package templates

import (
	"fmt"
	"strconv"
	"strings"
	"portfolio/internal/services"
)

templ Dashboard(gaData *services.AnalyticsData) {
	@DashboardLayout("Dashboard", "/dashboard") {
		<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

		<div class="space-y-8 w-full">
			if gaData != nil && gaData.LastError != "" {
				<div class="p-4 rounded-xl bg-[#141413] text-xs font-mono text-neutral-400">
					<p class="text-amber-400 font-medium mb-1">Setup Notice:</p>
					<p>{ gaData.LastError }</p>
				</div>
			}

			<!-- Top Stat Counters Across Full Width -->
			<div class="grid grid-cols-3 gap-6 pt-1 border-b border-neutral-800/40 pb-6 w-full">
				<div class="space-y-1">
					<p class="text-[11px] font-mono text-neutral-500 uppercase tracking-widest">Total Views</p>
					if gaData != nil && gaData.LastError == "" {
						<p class="text-2xl sm:text-3xl font-semibold text-white font-mono">{ fmt.Sprintf("%d", gaData.PageViews) }</p>
					} else {
						<p class="text-2xl sm:text-3xl font-semibold text-white font-mono">0</p>
					}
				</div>

				<div class="space-y-1">
					<p class="text-[11px] font-mono text-neutral-500 uppercase tracking-widest">Active Visitors</p>
					if gaData != nil && gaData.LastError == "" {
						<p class="text-2xl sm:text-3xl font-semibold text-white font-mono">{ fmt.Sprintf("%d", gaData.ActiveUsers) }</p>
					} else {
						<p class="text-2xl sm:text-3xl font-semibold text-white font-mono">0</p>
					}
				</div>

				<div class="space-y-1">
					<p class="text-[11px] font-mono text-neutral-500 uppercase tracking-widest">Avg Engagement</p>
					if gaData != nil && gaData.LastError == "" && gaData.AvgDuration != "" {
						<p class="text-2xl sm:text-3xl font-semibold text-white font-mono">{ gaData.AvgDuration }</p>
					} else {
						<p class="text-2xl sm:text-3xl font-semibold text-white font-mono">0s</p>
					}
				</div>
			</div>

			<!-- Main 2-Column Side-by-Side Flex Layout -->
			<div class="flex flex-col lg:flex-row gap-8 items-start w-full">
				
				<!-- Left Column (60% width): Traffic Trend Chart -->
				<div class="w-full lg:w-7/12 space-y-6">
					<div class="p-6 rounded-2xl bg-[#141413] space-y-4 w-full">
						<p class="text-xs font-mono text-neutral-400 uppercase tracking-wider">Traffic Trend (7 Days)</p>
						<div class="h-72 w-full relative">
							if gaData != nil {
								<canvas 
									id="trafficChart" 
									data-labels={ gaData.DailyLabels } 
									data-values={ gaData.DailyValues }
								></canvas>
							} else {
								<canvas 
									id="trafficChart" 
									data-labels='["Mon","Tue","Wed","Thu","Fri","Sat","Sun"]' 
									data-values='[0,0,0,0,0,0,0]'
								></canvas>
							}
						</div>
					</div>
				</div>

				<!-- Right Column (40% width): Per-Page Breakdown & Traffic Sources -->
				<div class="w-full lg:w-5/12 space-y-6">
					<!-- Per-Page Views Breakdown -->
					<div class="p-6 rounded-2xl bg-[#141413] space-y-4 w-full">
						<p class="text-xs font-mono text-neutral-400 uppercase tracking-wider">Per-Page Views</p>
						if gaData != nil && len(gaData.TopPages) > 0 {
							<div class="space-y-4 font-mono text-xs">
								for _, page := range gaData.TopPages {
									<div class="space-y-1.5">
										<div class="flex items-center justify-between text-neutral-300">
											<span class="font-medium text-white">{ page.Path }</span>
											<span class="text-neutral-400">{ fmt.Sprintf("%d views (%d%%)", page.Views, page.Percentage) }</span>
										</div>
										<div class="w-full bg-neutral-900 rounded-full h-1.5 overflow-hidden">
											<div class="bg-neutral-300 h-1.5 rounded-full" style={ fmt.Sprintf("width: %d%%;", page.Percentage) }></div>
										</div>
									</div>
								}
							</div>
						} else {
							<p class="text-xs font-mono text-neutral-500">No page data available yet</p>
						}
					</div>

					<!-- Traffic Sources -->
					<div class="p-6 rounded-2xl bg-[#141413] space-y-4 w-full">
						<p class="text-xs font-mono text-neutral-400 uppercase tracking-wider">Traffic Sources</p>
						if gaData != nil && len(gaData.Sources) > 0 {
							<div class="space-y-3 font-mono text-xs">
								for _, src := range gaData.Sources {
									<div class="flex items-center justify-between py-2 border-b border-neutral-800/40">
										<span class="text-white font-medium">{ src.Source }</span>
										<span class="text-neutral-400">{ fmt.Sprintf("%d visitors", src.Users) }</span>
									</div>
								}
							</div>
						} else {
							<div class="space-y-3 font-mono text-xs">
								<div class="flex items-center justify-between py-2 border-b border-neutral-800/40">
									<span class="text-white font-medium">Direct</span>
									<span class="text-neutral-400">100%</span>
								</div>
							</div>
						}
					</div>
				</div>

			</div>
		</div>

		<!-- Minimalist Dark Chart.js Script -->
		<script>
			document.addEventListener("DOMContentLoaded", function() {
				const ctx = document.getElementById('trafficChart');
				if (!ctx) return;

				let labels = [];
				let values = [];
				try {
					labels = JSON.parse(ctx.dataset.labels || '[]');
					values = JSON.parse(ctx.dataset.values || '[]');
				} catch (e) {
					console.error("Failed to parse chart data:", e);
				}

				const gradient = ctx.getContext('2d').createLinearGradient(0, 0, 0, 260);
				gradient.addColorStop(0, 'rgba(255, 255, 255, 0.12)');
				gradient.addColorStop(1, 'rgba(255, 255, 255, 0.0)');

				new Chart(ctx, {
					type: 'line',
					data: {
						labels: labels,
						datasets: [{
							label: 'Page Views',
							data: values,
							borderColor: '#e5e5e5',
							borderWidth: 2,
							pointBackgroundColor: '#ffffff',
							pointRadius: 3,
							pointHoverRadius: 5,
							fill: true,
							backgroundColor: gradient,
							tension: 0.35
						}]
					},
					options: {
						responsive: true,
						maintainAspectRatio: false,
						plugins: {
							legend: { display: false },
							tooltip: {
								backgroundColor: '#181817',
								titleColor: '#ffffff',
								bodyColor: '#a3a3a3',
								borderColor: '#262626',
								borderWidth: 1,
								padding: 10,
								displayColors: false,
								callbacks: {
									label: function(context) {
										return context.parsed.y + ' views';
									}
								}
							}
						},
						scales: {
							x: {
								grid: { display: false },
								ticks: { color: '#737373', font: { family: 'monospace', size: 10 } }
							},
							y: {
								grid: { color: '#262626', drawBorder: false },
								ticks: { color: '#737373', font: { family: 'monospace', size: 10 }, precision: 0 }
							}
						}
					}
				});
			});
		</script>
	}
}

templ DashboardProjects(projects []services.ProjectRecord, currentPage int, totalPages int, err error) {
	@DashboardLayout("Projects", "/dashboard/projects") {
		<div style="display: flex; flex-direction: column; min-height: calc(100vh - 160px); width: 100%;">
			<div style="display: flex; align-items: center; justify-content: flex-end; width: 100%;">
				<a 
					href="/dashboard/projects/new" 
					style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1.25rem; background-color: #ffffff; color: #000000; border-radius: 0.75rem; font-family: var(--font-mono, monospace); font-size: 0.75rem; font-weight: 500; text-decoration: none;"
				>
					<img src="/static/icons/plus.svg" alt="Add" draggable="false" style="width: 14px; height: 14px; min-width: 14px; max-width: 14px; filter: invert(0); display: inline-block; vertical-align: middle;" />
					<span>Add Project</span>
				</a>
			</div>

			if (err != nil || len(projects) == 0) {
				<div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; width: 100%;">
					<div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; max-width: 420px; margin: 0 auto;">
						<img src="/static/icons/projects.svg" alt="Projects" draggable="false" style="width: 40px; height: 40px; min-width: 40px; max-width: 40px; opacity: 0.5; display: block; margin: 0 auto;" />
						<div style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem; width: 100%;">
							
							<p style="font-family: var(--font-mono, monospace); font-size: 1.125rem; font-weight: 600; color: #e5e5e5; margin: 0; text-align: center;">
								if err != nil {
									<span>Error Loading Projects</span>
								} else {
									<span>No Projects Found</span>
								}
							</p>
							<p style="font-family: var(--font-sans, sans-serif); font-size: 0.875rem; color: #a3a3a3; line-height: 1.5; margin: 0; text-align: center;">
								if err != nil {
									<span>{ err.Error() }</span>
								} else {
									<span>You haven't added any custom projects yet. Click "Add Project" above to create your first portfolio entry.</span>
								}
							</p>
						</div>
					</div>
				</div>
			} else {
				<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 sm:gap-8 mt-6 w-full">
					for _, p := range projects {
						<div style="background-color: #141413; border: 1px solid #262626; border-radius: 1rem; padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between; gap: 1rem; transition: all 0.2s ease;" class="hover:border-neutral-700">
							<div style="display: flex; flex-direction: column; gap: 0.875rem;">
								if p.ThumbnailURL != "" {
									<a href={ templ.SafeURL(fmt.Sprintf("/dashboard/projects/edit/%s", p.Slug)) } style="display: block; width: 100%; border-radius: 0.75rem; overflow: hidden; border: 1px solid #262626; aspect-ratio: 16/9;">
										<img 
											src={ p.ThumbnailURL } 
											alt={ p.Title } 
											style="width: 100%; height: 100%; object-fit: cover; display: block;" 
										/>
									</a>
								}

								<div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; width: 100%;">
									<a href={ templ.SafeURL(fmt.Sprintf("/dashboard/projects/edit/%s", p.Slug)) } style="text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
										<h3 style="font-family: var(--font-mono, monospace); font-size: 1rem; font-weight: 700; color: #ffffff; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{ p.Title }</h3>
									</a>

									<div style="display: flex; align-items: center; gap: 0.375rem; flex-shrink: 0;">
										if p.IsFeatured {
											<span style="background: rgba(245, 158, 11, 0.1); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 9999px; padding: 0.2rem 0.5rem; font-family: var(--font-mono, monospace); font-size: 0.625rem; font-weight: 600;">★ Featured</span>
										}
										if !p.IsGitHubPrivate && p.GitHubURL != "" {
											<a href={ templ.SafeURL(p.GitHubURL) } target="_blank" rel="noreferrer" title="GitHub Repository" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem; padding: 0.25rem 0.625rem; border-radius: 0.5rem; background: #1a1a18; border: 1px solid #282826; text-decoration: none;">
												<img src="/static/icons/github.svg" alt="GitHub" style="width: 12px; height: 12px; filter: invert(1); opacity: 0.8;" />
												<span style="font-family: var(--font-mono, monospace); font-size: 0.6875rem; font-weight: 500; color: #d4d4d4;">GitHub</span>
											</a>
										}
										if p.LiveURL != "" {
											<a href={ templ.SafeURL(p.LiveURL) } target="_blank" rel="noreferrer" title="Live Demo" style="display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem; padding: 0.25rem 0.625rem; border-radius: 0.5rem; background: #1a1a18; border: 1px solid #282826; text-decoration: none;">
												<span style="font-family: var(--font-mono, monospace); font-size: 0.6875rem; font-weight: 500; color: #d4d4d4;">View</span>
												<img src="/static/icons/arrow-up-right.svg" alt="Live Demo" style="width: 12px; height: 12px; filter: invert(1); opacity: 0.8;" />
											</a>
										}
									</div>
								</div>

								if p.ShortDescription != "" {
									<p style="font-family: var(--font-sans, sans-serif); font-size: 0.8125rem; color: #a3a3a3; line-height: 1.5; margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">{ p.ShortDescription }</p>
								}

								if len(p.Languages) > 0 {
									<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem; padding-top: 0.25rem;">
										for _, lang := range p.Languages {
											<span style="background: #1a1a18; border: 1px solid #282826; border-radius: 0.5rem; padding: 0.25rem 0.625rem; font-family: var(--font-mono, monospace); font-size: 0.6875rem; color: #d4d4d4; display: inline-flex; align-items: center; gap: 0.375rem;">
												<span>{ lang.Name }</span>
												<span style="color: #737373; font-family: var(--font-sans, sans-serif);">{ fmt.Sprintf("%.1f%%", lang.Percentage) }</span>
											</span>
										}
									</div>
								}

								if p.Tags != "" {
									<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem; font-family: var(--font-mono, monospace); font-size: 0.6875rem; color: #737373; padding-top: 0.125rem;">
										<span style="color: #525252; font-weight: 600; text-transform: uppercase; font-size: 0.625rem; margin-right: 0.125rem;">TAGS:</span>
										for _, tag := range strings.Split(p.Tags, ",") {
											if strings.TrimSpace(tag) != "" {
												<span style="background: #111110; border: 1px solid #222220; border-radius: 0.375rem; padding: 0.1875rem 0.5rem; color: #a3a3a3;">{ strings.TrimSpace(tag) }</span>
											}
										}
									</div>
								}
							</div>

							<div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #262626; padding-top: 0.75rem; margin-top: 0.5rem; font-family: var(--font-mono, monospace); font-size: 0.75rem;">
								<div style="display: flex; align-items: center; gap: 1rem; color: #a3a3a3;">
									<div style="display: flex; align-items: center; gap: 0.375rem;" title="Stars">
										<img src="/static/icons/star.svg" alt="Stars" style="width: 14px; height: 14px; min-width: 14px; max-width: 14px; opacity: 0.75; display: inline-block; margin-right: 0.25rem;" />
										<span style="color: #e5e5e5; font-weight: 500;">{ strconv.Itoa(p.StarsCount) }</span>
									</div>

									<div style="display: flex; align-items: center; gap: 0.375rem;" title="Commits">
										<img src="/static/icons/commit.svg" alt="Commits" style="width: 14px; height: 14px; min-width: 14px; max-width: 14px; opacity: 0.75; display: inline-block; margin-right: 0.25rem;" />
										<span style="color: #e5e5e5; font-weight: 500;">{ strconv.Itoa(p.CommitsCount) }</span>
									</div>

									<div style="display: flex; align-items: center; gap: 0.375rem;" title="Views">
										<img src="/static/icons/eye.svg" alt="Views" style="width: 14px; height: 14px; min-width: 14px; max-width: 14px; opacity: 0.75; display: inline-block; margin-right: 0.25rem;" />
										<span style="color: #e5e5e5; font-weight: 500;">{ strconv.Itoa(p.ViewsCount) }</span>
									</div>
								</div>

								<a 
									href={ templ.SafeURL(fmt.Sprintf("/dashboard/projects/edit/%s", p.Slug)) } 
									style="background: #222220; border: 1px solid #333330; color: #e5e5e5; border-radius: 0.5rem; padding: 0.25rem 0.75rem; font-size: 0.75rem; font-weight: 500; font-family: var(--font-mono, monospace); text-decoration: none; transition: all 0.2s;"
								>
									Edit
								</a>
							</div>
						</div>
					}
				</div>

				if totalPages > 1 {
					<div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #262626; width: 100%; font-family: var(--font-mono, monospace);">
						<div style="font-size: 0.75rem; color: #a3a3a3;">
							Page <span style="color: #ffffff; font-weight: 600;">{ strconv.Itoa(currentPage) }</span> of <span style="color: #ffffff; font-weight: 600;">{ strconv.Itoa(totalPages) }</span>
						</div>

						<div style="display: flex; align-items: center; gap: 0.5rem;">
							if currentPage > 1 {
								<a 
									href={ templ.SafeURL(fmt.Sprintf("/dashboard/projects?page=%d", currentPage-1)) } 
									style="display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.375rem 0.875rem; background-color: #141413; border: 1px solid #262626; border-radius: 0.5rem; color: #e5e5e5; font-size: 0.75rem; text-decoration: none; transition: all 0.2s;"
								>
									<img src="/static/icons/arrow-left.svg" alt="Prev" style="width: 12px; height: 12px; filter: invert(1); opacity: 0.8;" />
									<span>Previous</span>
								</a>
							} else {
								<span style="display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.375rem 0.875rem; background-color: #141413; border: 1px solid #1f1f1f; border-radius: 0.5rem; color: #525252; font-size: 0.75rem; cursor: not-allowed;">
									<img src="/static/icons/arrow-left.svg" alt="Prev" style="width: 12px; height: 12px; filter: invert(1); opacity: 0.3;" />
									<span>Previous</span>
								</span>
							}

							<div style="display: flex; align-items: center; gap: 0.25rem;">
								for pIdx := 1; pIdx <= totalPages; pIdx++ {
									if pIdx == currentPage {
										<span style="display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 0.5rem; background-color: #ffffff; color: #000000; font-size: 0.75rem; font-weight: 700;">
											{ strconv.Itoa(pIdx) }
										</span>
									} else {
										<a 
											href={ templ.SafeURL(fmt.Sprintf("/dashboard/projects?page=%d", pIdx)) } 
											style="display: inline-flex; align-items: center; justify-content: justify; width: 32px; height: 32px; border-radius: 0.5rem; background-color: #141413; border: 1px solid #262626; color: #a3a3a3; font-size: 0.75rem; text-decoration: none; transition: all 0.2s;"
										>
											{ strconv.Itoa(pIdx) }
										</a>
									}
								}
							</div>

							if currentPage < totalPages {
								<a 
									href={ templ.SafeURL(fmt.Sprintf("/dashboard/projects?page=%d", currentPage+1)) } 
									style="display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.375rem 0.875rem; background-color: #141413; border: 1px solid #262626; border-radius: 0.5rem; color: #e5e5e5; font-size: 0.75rem; text-decoration: none; transition: all 0.2s;"
								>
									<span>Next</span>
									<img src="/static/icons/arrow-up-right.svg" alt="Next" style="width: 12px; height: 12px; filter: invert(1); opacity: 0.8;" />
								</a>
							} else {
								<span style="display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.375rem 0.875rem; background-color: #141413; border: 1px solid #1f1f1f; border-radius: 0.5rem; color: #525252; font-size: 0.75rem; cursor: not-allowed;">
									<span>Next</span>
									<img src="/static/icons/arrow-up-right.svg" alt="Next" style="width: 12px; height: 12px; filter: invert(1); opacity: 0.3;" />
								</span>
							}
						</div>
					</div>
				}
			}
		</div>
	}
}

templ DashboardProjectNewEdit(project *services.ProjectRecord) {
	if project == nil {
		@DashboardLayout("Add New Project", "/dashboard/projects") {
			<script src="/static/scripts/sweetalert2.all.min.js?v=4"></script>
			<form id="create-project-form" action="/dashboard/projects/new" method="POST" enctype="multipart/form-data" class="w-full space-y-8 pb-12">
				@projectFormContent(project)
			</form>
		}
	} else {
		@DashboardLayout("Edit Project", "/dashboard/projects") {
			<script src="/static/scripts/sweetalert2.all.min.js?v=4"></script>
			<form id="create-project-form" action={ templ.SafeURL(fmt.Sprintf("/dashboard/projects/edit/%s", project.Slug)) } method="POST" enctype="multipart/form-data" class="w-full space-y-8 pb-12">
				@projectFormContent(project)
			</form>
		}
	}
}

templ projectFormContent(project *services.ProjectRecord) {
	<div class="sticky top-0 z-30 bg-[#181817]/95 backdrop-blur-md border-b border-neutral-800/80 py-4 mb-6 flex items-center justify-between w-full">
		<div>
			<h1 class="text-lg font-bold text-white font-mono">
				if project != nil {
					Edit Project
				} else {
					Create Project
				}
			</h1>
		</div>

		<div class="flex items-center gap-2">
			<button 
				type="submit"
				title="Save Project"
				class="p-2 rounded-xl text-neutral-400 hover:text-white hover:bg-neutral-800/60 transition-all flex items-center justify-center border-0 cursor-pointer bg-transparent"
			>
				<img src="/static/icons/save.svg" alt="Save" draggable="false" style="width: 20px; height: 20px; min-width: 20px;" class="object-contain opacity-80 hover:opacity-100 filter invert" />
			</button>

			<a 
				href="/dashboard/projects"
				title="Cancel and return to projects"
				class="p-2 rounded-xl text-neutral-400 hover:text-white hover:bg-neutral-800/60 transition-all flex items-center justify-center"
			>
				<img src="/static/icons/close.svg" alt="Close" draggable="false" style="width: 20px; height: 20px; min-width: 20px;" class="object-contain opacity-80 hover:opacity-100" />
			</a>
		</div>
	</div>

	if project != nil {
		<div class="p-5 rounded-2xl bg-[#141413] border border-neutral-800 space-y-4">
			<h2 class="text-xs font-mono uppercase tracking-wider text-neutral-400 font-bold">Project Stats & Details</h2>
			<div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
				<div class="p-3 rounded-xl bg-[#181817] border border-neutral-800/60">
					<p class="text-[10px] font-mono text-neutral-500 uppercase">Stars</p>
					<p style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.25rem;" class="text-base font-bold font-mono text-white">
						<img src="/static/icons/star.svg" alt="Stars" style="width: 16px; height: 16px; min-width: 16px; max-width: 16px; opacity: 0.85; display: inline-block; vertical-align: middle; margin-right: 0.375rem;" />
						<span>{ strconv.Itoa(project.StarsCount) }</span>
					</p>
				</div>
				<div class="p-3 rounded-xl bg-[#181817] border border-neutral-800/60">
					<p class="text-[10px] font-mono text-neutral-500 uppercase">Commits</p>
					<p style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.25rem;" class="text-base font-bold font-mono text-white">
						<img src="/static/icons/commit.svg" alt="Commits" style="width: 16px; height: 16px; min-width: 16px; max-width: 16px; opacity: 0.85; display: inline-block; vertical-align: middle; margin-right: 0.375rem;" />
						<span>{ strconv.Itoa(project.CommitsCount) }</span>
					</p>
				</div>
				<div class="p-3 rounded-xl bg-[#181817] border border-neutral-800/60">
					<p class="text-[10px] font-mono text-neutral-500 uppercase">Views</p>
					<p style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.25rem;" class="text-base font-bold font-mono text-white">
						<img src="/static/icons/eye.svg" alt="Views" style="width: 16px; height: 16px; min-width: 16px; max-width: 16px; opacity: 0.85; display: inline-block; vertical-align: middle; margin-right: 0.375rem;" />
						<span>{ strconv.Itoa(project.ViewsCount) }</span>
					</p>
				</div>
				<div class="p-3 rounded-xl bg-[#181817] border border-neutral-800/60">
					<p class="text-[10px] font-mono text-neutral-500 uppercase">Visibility</p>
					<p class="text-xs font-semibold font-mono text-neutral-300 mt-1">
						if project.IsGitHubPrivate {
							Private Repo
						} else {
							Public Repo
						}
					</p>
				</div>
			</div>

			if len(project.Languages) > 0 {
				<div class="space-y-1.5 pt-2">
					<p class="text-[10px] font-mono text-neutral-500 uppercase">Languages</p>
					<div class="flex flex-wrap items-center gap-2">
						for _, lang := range project.Languages {
							<span class="px-2.5 py-1 rounded-lg bg-[#181817] border border-neutral-800 text-xs font-mono text-neutral-300">
								{ lang.Name } <span class="text-neutral-500 ml-1">{ fmt.Sprintf("%.1f%%", lang.Percentage) }</span>
							</span>
						}
					</div>
				</div>
			}
		</div>
	}

		<div class="flex flex-wrap items-center gap-6 p-4 rounded-xl bg-[#141413] border border-neutral-800/60 w-full select-none">
			<label class="flex items-center gap-2.5 cursor-pointer select-none">
				<input 
					type="checkbox" 
					name="is_public" 
					value="true" 
					if project == nil || project.IsPublic {
						checked
					}
					class="size-4 rounded accent-white bg-[#181817] border-neutral-700"
				/>
				<span class="text-xs font-mono text-neutral-300 select-none">Public</span>
			</label>

			<label class="flex items-center gap-2.5 cursor-pointer select-none">
				<input 
					type="checkbox" 
					name="is_featured" 
					value="true" 
					if project != nil && project.IsFeatured {
						checked
					}
					class="size-4 rounded accent-white bg-[#181817] border-neutral-700"
				/>
				<span class="text-xs font-mono text-neutral-300 select-none">Featured</span>
			</label>
		</div>

		<div class="space-y-2 w-full">
			<label class="block text-xs font-mono text-neutral-300 uppercase tracking-wider">
				Project Thumbnail Image
				if project == nil {
					*
				}
			</label>
			<div class="flex items-center justify-center w-full">
				<label class="relative flex flex-col items-center justify-center w-full h-48 sm:h-56 border border-dashed border-neutral-800 rounded-xl cursor-pointer bg-[#141413] hover:bg-[#181817] hover:border-neutral-700 transition-all select-none overflow-hidden p-4">
					
					<div id="upload-placeholder" class={ "flex flex-col items-center justify-center pt-5 pb-6 select-none", templ.KV("hidden", project != nil && project.ThumbnailURL != "") }>
						<img src="/static/icons/plus.svg" alt="Upload" draggable="false" class="size-6 opacity-60 mb-3 invert" />
						<p class="text-xs font-mono text-neutral-400 select-none">Click to upload thumbnail image</p>
						<p class="text-[11px] font-mono text-neutral-500 mt-1.5 select-none">PNG, JPG, WebP up to 5MB</p>
					</div>

					<div id="preview-container" class={ "w-full h-full flex flex-col items-center justify-center relative", templ.KV("hidden", project == nil || project.ThumbnailURL == "") }>
						if project != nil && project.ThumbnailURL != "" {
							<img id="thumbnail-preview" src={ project.ThumbnailURL } alt="Thumbnail Preview" class="max-h-40 max-w-full rounded-lg object-contain border border-neutral-800" />
						} else {
							<img id="thumbnail-preview" src="#" alt="Thumbnail Preview" class="max-h-40 max-w-full rounded-lg object-contain border border-neutral-800" />
						}
						<p class="text-[11px] font-mono text-neutral-400 mt-2">Click to change image</p>
					</div>

					<input 
						type="file" 
						id="thumbnail-input"
						name="thumbnail" 
						accept="image/*" 
						if project == nil {
							required
						}
						style="font-size: 0; color: transparent; opacity: 0;"
						class="absolute inset-0 w-full h-full cursor-pointer"
						onchange="handleThumbnailPreview(this)"
					/>
				</label>
			</div>
		</div>

		<div class="space-y-2 w-full">
			<label class="block text-xs font-mono text-neutral-300 uppercase tracking-wider">Project Name *</label>
			<input 
				type="text" 
				name="title" 
				id="project-title"
				if project != nil {
					value={ project.Title }
				}
				required 
				class="w-full px-4 py-3 rounded-xl bg-[#141413] border border-neutral-800 focus:border-neutral-600 text-sm text-white focus:outline-none transition-colors"
			/>
		</div>

		<div class="space-y-2 w-full">
			<label class="block text-xs font-mono text-neutral-300 uppercase tracking-wider">Project Slug *</label>
			<input 
				type="text" 
				name="slug" 
				id="project-slug"
				if project != nil {
					value={ project.Slug }
				}
				required 
				class="w-full px-4 py-3 rounded-xl bg-[#141413] border border-neutral-800 focus:border-neutral-600 text-sm text-white focus:outline-none transition-colors font-mono text-xs text-neutral-300"
			/>
		</div>

		<div class="space-y-2 w-full">
			<label class="block text-xs font-mono text-neutral-300 uppercase tracking-wider">GitHub Repository URL *</label>
			<input 
				type="url" 
				name="github_url" 
				if project != nil {
					value={ project.GitHubURL }
				}
				required
				class="w-full px-4 py-3 rounded-xl bg-[#141413] border border-neutral-800 focus:border-neutral-600 text-sm text-white focus:outline-none transition-colors"
			/>
		</div>

		<div class="space-y-2 w-full">
			<label class="block text-xs font-mono text-neutral-300 uppercase tracking-wider">Live Demo / Website URL</label>
			<input 
				type="url" 
				name="live_url" 
				if project != nil {
					value={ project.LiveURL }
				}
				class="w-full px-4 py-3 rounded-xl bg-[#141413] border border-neutral-800 focus:border-neutral-600 text-sm text-white focus:outline-none transition-colors"
			/>
		</div>

		<div class="space-y-2 w-full">
			<label class="block text-xs font-mono text-neutral-300 uppercase tracking-wider">Tech Stack Tags *</label>
			<input 
				type="text" 
				name="tags" 
				if project != nil {
					value={ project.Tags }
				}
				required
				class="w-full px-4 py-3 rounded-xl bg-[#141413] border border-neutral-800 focus:border-neutral-600 text-sm text-white focus:outline-none transition-colors"
			/>
		</div>

		<div class="space-y-2 w-full">
			<label class="block text-xs font-mono text-neutral-300 uppercase tracking-wider">Short Description *</label>
			<textarea 
				name="short_description" 
				required 
				rows="3"
				placeholder="Brief overview shown in project cards and previews..."
				class="w-full px-4 py-3 rounded-xl bg-[#141413] border border-neutral-800 focus:border-neutral-600 text-sm text-white focus:outline-none transition-colors leading-relaxed"
			>
				if project != nil {
					{ project.ShortDescription }
				}
			</textarea>
		</div>

		<div class="space-y-2 w-full">
			<label class="block text-xs font-mono text-neutral-300 uppercase tracking-wider">Long Description</label>
			<textarea 
				name="long_description" 
				rows="5"
				placeholder="Detailed description..."
				class="w-full px-4 py-3 rounded-xl bg-[#141413] border border-neutral-800 focus:border-neutral-600 text-sm text-white focus:outline-none transition-colors leading-relaxed"
			>
				if project != nil {
					{ project.LongDescription }
				}
			</textarea>
		</div>

		<script>
			function handleThumbnailPreview(input) {
				const placeholder = document.getElementById('upload-placeholder');
				const previewContainer = document.getElementById('preview-container');
				const previewImage = document.getElementById('thumbnail-preview');

				if (input.files && input.files[0]) {
					const reader = new FileReader();
					reader.onload = function(e) {
						previewImage.src = e.target.result;
						placeholder.classList.add('hidden');
						previewContainer.classList.remove('hidden');
					}
					reader.readAsDataURL(input.files[0]);
				}
			}

			document.addEventListener("DOMContentLoaded", function() {
				const titleInput = document.getElementById("project-title");
				const slugInput = document.getElementById("project-slug");

				function generateSlug(text) {
					return text
						.toString()
						.toLowerCase()
						.trim()
						.replace(/\s+/g, '-')
						.replace(/[^\w\-]+/g, '')
						.replace(/\-\-+/g, '-')
						.replace(/^-+/, '')
						.replace(/-+$/, '');
				}

				if (titleInput && slugInput) {
					titleInput.addEventListener("input", function() {
						slugInput.value = generateSlug(this.value);
					});
				}

				const form = document.getElementById("create-project-form");
				if (!form) return;

				form.addEventListener("submit", async function(e) {
					e.preventDefault();
					const SwalObj = window.Swal || window.Sweetalert2 || (typeof Sweetalert2 !== 'undefined' ? Sweetalert2 : null);

					const formData = new FormData(form);
					const targetUrl = form.getAttribute("action") || "/dashboard/projects/new";
					try {
						const res = await fetch(targetUrl, {
							method: "POST",
							headers: {
								"X-Requested-With": "XMLHttpRequest",
								"Accept": "application/json"
							},
							body: formData
						});

						if (res.redirected) {
							window.location.href = res.url;
							return;
						}

						if (!res.ok) {
							const data = await res.json();
							if (SwalObj) {
								SwalObj.fire({
									icon: 'error',
									title: 'Submission Error',
									text: data.error || 'Failed to save project',
									background: '#141413',
									color: '#ffffff',
									confirmButtonColor: '#262626',
									customClass: {
										popup: 'border border-neutral-800 rounded-2xl font-mono text-sm'
									}
								});
							}
						}
					} catch (err) {
						if (SwalObj) {
							SwalObj.fire({
								icon: 'error',
								title: 'Error',
								text: 'Network error or server unavailable',
								background: '#141413',
								color: '#ffffff',
								confirmButtonColor: '#262626',
								customClass: {
									popup: 'border border-neutral-800 rounded-2xl font-mono text-sm'
								}
							});
						}
					}
				});
			});
		</script>
}