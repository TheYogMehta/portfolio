package templates

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

			if title != "" {
				<title>{ title } | Yog Mehta</title>
			} else {
				<title>Yog Mehta</title>
			}

			<link rel="icon" type="image/png" href="/static/images/logo.png" />
			<link rel="stylesheet" href="/static/css/output.css"/>

			<!-- Google Analytics (gtag.js) -->
			<script async src="https://www.googletagmanager.com/gtag/js?id=G-6M5V3RVK8T"></script>
			<script>
			  window.dataLayer = window.dataLayer || [];
			  function gtag(){dataLayer.push(arguments);}
			  gtag('js', new Date());

			  gtag('config', 'G-6M5V3RVK8T');
			</script>
		</head>
		<body class="bg-[#181817] text-neutral-200 font-sans antialiased flex flex-col min-h-screen">
			@Header()
			<main class="container mx-auto p-4 flex-1">
				{ children... }
			</main>
			@Footer()
		</body>
	</html>
}

templ Header() {
	<header class="w-full border-b border-neutral-800 bg-[#181817]">
		<div class="w-full px-4 sm:px-6 lg:px-8">
			<div class="relative flex h-16 items-center justify-between">
				
				<div class="flex items-center gap-3">
					<a class="block" href="/">
						<img src="/static/images/logo.png" alt="logo" class="size-9 rounded-lg" />
					</a>
				</div>

				<div class="hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 items-center justify-center">
					<nav aria-label="Global">
						<ul class="flex items-center gap-8 text-sm font-medium">
							@QuickLink("Home", "/")
							@QuickLink("About", "/about")
							@QuickLink("Projects", "/projects")
							@QuickLink("Contact", "/contact")
						</ul>
					</nav>
				</div>

				<div class="md:hidden flex items-center">
					<button 
						id="mobile-menu-btn"
						onclick="document.getElementById('mobile-menu').classList.remove('hidden')" 
						class="p-2 text-neutral-300 hover:text-white focus:outline-none"
						aria-label="Open Menu"
					>
						<svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
						</svg>
					</button>
				</div>
			</div>
		</div>

		<div id="mobile-menu" class="hidden fixed inset-0 z-50 bg-[#181817] flex flex-col justify-between p-6 sm:p-8 md:hidden">
			<div class="flex items-center justify-between">
				<div class="flex items-center gap-3">
					<img src="/static/images/logo.png" alt="logo" class="size-9 rounded-lg" />
				</div>
				<button 
					onclick="document.getElementById('mobile-menu').classList.add('hidden')" 
					class="p-2 text-neutral-400 hover:text-white focus:outline-none"
					aria-label="Close Menu"
				>
					<svg class="size-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
					</svg>
				</button>
			</div>

			<nav aria-label="Global Mobile" class="my-auto flex flex-col items-center">
				<ul class="flex flex-col items-center gap-8 text-2xl font-medium tracking-tight">
					@QuickLink("Home", "/")
					@QuickLink("About", "/about")
					@QuickLink("Projects", "/projects")
					@QuickLink("Contact", "/contact")
				</ul>
			</nav>
		</div>

	</header>
}

templ Footer() {
	<footer>
		<div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8 border-t border-neutral-800/60 mt-16">
			<div class="flex flex-col sm:flex-row items-center justify-between gap-6">

				<ul class="flex items-center gap-6">
					@SocialLink("https://github.com/theYogMehta/", "/static/icons/github.svg", "GitHub")
					@SocialLink("https://www.linkedin.com/in/yog-mehta-143b80231/", "/static/icons/linkedin.svg", "LinkedIn")
				</ul>

				<p class="text-xs font-mono text-neutral-500 text-center sm:text-left flex items-center justify-center sm:justify-start gap-2">
					<img src="/static/icons/copyright.svg" alt="Copyright" draggable="false" style="width: 12px; height: 12px; min-width: 12px; max-width: 12px; display: inline-block; vertical-align: middle; opacity: 0.6; margin-right: 2px;" />
					<span>2026 Yog Mehta • Built with Go & Templ</span>
				</p>
			</div>
		</div>
	</footer>
}

templ QuickLink(name string, href string) {
	<li>
		<a 
			class="text-neutral-400 transition hover:text-white" 
			href={ templ.SafeURL(href) }
		>
			{ name }
		</a>
	</li>
}

templ SocialLink(href string, iconPath string, label string) {
	<li>
		<a 
			href={ templ.SafeURL(href) } 
			target="_blank" 
			rel="noreferrer" 
			class="text-neutral-400 hover:text-white transition-colors"
		>
			<span class="sr-only">{ label }</span>
			<img src={ iconPath } alt={ label } draggable="false" class="size-5 invert opacity-80 hover:opacity-100 transition-opacity" />
		</a>
	</li>
}

templ DashboardLayout(title string, activePath string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1.0" />
			<title>{ title } | Yog Mehta</title>
			<link rel="icon" type="image/png" href="/static/images/logo.png" />
			<link rel="stylesheet" href="/static/css/output.css"/>
			<style>
				@media (min-width: 768px) {
					.dashboard-wrapper {
						display: flex !important;
						flex-direction: row !important;
						min-height: 100vh !important;
						width: 100% !important;
					}
					.dashboard-sidebar-aside {
						width: 240px !important;
						min-width: 240px !important;
						height: 100vh !important;
						position: sticky !important;
						top: 0 !important;
						display: flex !important;
						flex-direction: column !important;
						justify-content: space-between !important;
					}
					.mobile-admin-bar {
						display: none !important;
					}
				}

				@media (max-width: 767px) {
					.dashboard-wrapper {
						display: flex !important;
						flex-direction: column !important;
						width: 100% !important;
					}
					.dashboard-sidebar-aside {
						display: none;
					}
					.mobile-admin-bar {
						display: flex !important;
					}
				}
			</style>
		</head>
		<body class="bg-[#181817] text-neutral-200 font-sans antialiased min-h-screen flex flex-col overflow-x-hidden">
			<div class="dashboard-wrapper flex-1 bg-[#181817]">
				@SideBar(activePath)
				<main class="dashboard-main-area flex-1 flex flex-col justify-between p-6 sm:p-10 lg:p-12 min-h-screen">
					<div class="w-full">
						{ children... }
					</div>
					<div class="mt-auto w-full pt-8">
						@Footer()
					</div>
				</main>
			</div>
		</body>
	</html>
}

templ SideBar(activePath string) {
	<div class="mobile-admin-bar w-full border-b border-neutral-800 bg-[#141413] px-4 py-3 items-center justify-between">
		<a href="/" class="flex items-center gap-3">
			<img src="/static/images/logo.png" alt="logo" style="width: 24px; height: 24px;" class="object-contain rounded-md" />
			<span class="text-xs font-bold text-white font-mono uppercase tracking-wider">YOG MEHTA</span>
		</a>
		<button 
			onclick="document.getElementById('mobile-admin-menu').classList.remove('hidden')" 
			class="p-2 text-neutral-300 hover:text-white focus:outline-none"
		>
			<img src="/static/icons/menu.svg" alt="Menu" style="width: 24px; height: 24px;" class="object-contain opacity-90 hover:opacity-100" />
		</button>
	</div>

	<div id="mobile-admin-menu" class="hidden fixed inset-0 z-50 bg-[#181817] flex flex-col justify-between p-6 md:hidden">
		<div class="flex items-center justify-between">
			<a href="/" class="flex items-center gap-3">
				<img src="/static/images/logo.png" alt="logo" style="width: 28px; height: 28px;" class="object-contain rounded-md" />
				<span class="text-sm font-bold text-white font-mono uppercase tracking-wider">YOG MEHTA</span>
			</a>
			<button 
				onclick="document.getElementById('mobile-admin-menu').classList.add('hidden')" 
				class="p-2 text-neutral-400 hover:text-white focus:outline-none"
			>
				<img src="/static/icons/close.svg" alt="Close" style="width: 28px; height: 28px;" class="object-contain opacity-90 hover:opacity-100" />
			</button>
		</div>

		<nav class="my-auto flex flex-col items-center">
			<ul class="flex flex-col items-center gap-8 text-2xl font-medium tracking-tight">
				<li>
					<a href="/dashboard" class="text-white hover:text-white/80">Dashboard</a>
				</li>
				<li>
					<a href="/dashboard/projects" class="text-white hover:text-white/80">Projects</a>
				</li>
				<li>
					<a href="/logout" class="text-red-400 hover:text-red-300">Log Out</a>
				</li>
			</ul>
		</nav>
	</div>

	<aside class="dashboard-sidebar-aside bg-[#141413] flex flex-col justify-between p-6">
		<div class="space-y-8">
			<div class="px-1 pt-2">
				<a href="/" title="Go to Home" class="flex items-center gap-3 group">
					<img src="/static/images/logo.png" alt="Logo" style="width: 28px; height: 28px; min-width: 28px;" class="object-contain rounded-md group-hover:opacity-80 transition-opacity" />
					<div class="flex flex-col">
						<span class="text-xs font-bold text-neutral-200 group-hover:text-white transition-colors tracking-wider font-mono uppercase">
							Yog Mehta
						</span>
						<span class="text-[10px] font-mono text-neutral-500 uppercase tracking-widest">Dashboard</span>
					</div>
				</a>
			</div>

			<nav class="flex flex-col space-y-1.5 pt-2">
				@DashboardNavLink("Dashboard", "/dashboard", "/static/icons/home.svg", activePath == "/dashboard" || activePath == "")
				@DashboardNavLink("Projects", "/dashboard/projects", "/static/icons/projects.svg", activePath == "/dashboard/projects")
			</nav>
		</div>

		<div class="pt-4">
			<a 
				href="/logout"
				class="flex items-center gap-3 w-full px-3.5 py-2.5 rounded-xl text-xs font-medium text-red-400 hover:bg-red-950/20 transition-colors"
			>
				<img src="/static/icons/logout.svg" alt="Logout" style="width: 14px; height: 14px; min-width: 14px;" class="object-contain opacity-90" />
				<span>Log Out</span>
			</a>
		</div>
	</aside>
}

templ DashboardNavLink(name string, href string, iconPath string, active bool) {
	if active {
		<a 
			href={ templ.SafeURL(href) }
			class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-medium text-white bg-neutral-800/60 hover:bg-neutral-800 transition-colors"
		>
			<img src={ iconPath } alt={ name } style="width: 16px; height: 16px; min-width: 16px;" class="object-contain opacity-90" />
			<span>{ name }</span>
		</a>
	} else {
		<a 
			href={ templ.SafeURL(href) }
			class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-medium text-neutral-400 hover:text-white hover:bg-neutral-800/40 transition-colors"
		>
			<img src={ iconPath } alt={ name } style="width: 16px; height: 16px; min-width: 16px;" class="object-contain opacity-70 hover:opacity-100" />
			<span>{ name }</span>
		</a>
	}
}