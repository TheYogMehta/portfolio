package templates

templ DashboardLayout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1.0" />
			<title>{ title } | Yog Mehta</title>
			<link rel="icon" type="image/png" href="/static/images/logo.png" />
			<link rel="stylesheet" href="/static/css/output.css"/>
			<style>
				/* Desktop styles */
				@media (min-width: 768px) {
					.dashboard-wrapper {
						display: flex !important;
						flex-direction: row !important;
						min-height: 100vh !important;
						width: 100% !important;
					}
					.dashboard-sidebar-aside {
						width: 240px !important;
						min-width: 240px !important;
						border-right: 1px solid #262626 !important;
						min-height: 100vh !important;
						display: flex !important;
					}
					.mobile-admin-bar {
						display: none !important;
					}
				}

				/* Mobile Phone styles */
				@media (max-width: 767px) {
					.dashboard-wrapper {
						display: flex !important;
						flex-direction: column !important;
						width: 100% !important;
					}
					.dashboard-sidebar-aside {
						display: none;
					}
					.mobile-admin-bar {
						display: flex !important;
					}
				}
			</style>
		</head>
		<body class="bg-[#181817] text-neutral-200 font-sans antialiased min-h-screen flex flex-col overflow-x-hidden">
			<div class="dashboard-wrapper flex-1 bg-[#181817]">
				@SideBar()
				<main class="dashboard-main-area flex-1 flex flex-col justify-between p-6 sm:p-12 min-h-screen">
					<div class="w-full">
						{ children... }
					</div>
					<div class="mt-auto w-full pt-4">
						@Footer()
					</div>
				</main>
			</div>
		</body>
	</html>
}

templ SideBar() {
	<!-- Mobile Top Bar -->
	<div class="mobile-admin-bar w-full border-b border-neutral-800 bg-[#141413] px-4 py-3 items-center justify-between">
		<a href="/" class="flex items-center gap-2">
			<img src="/static/images/logo.png" alt="logo" style="width: 24px; height: 24px;" class="object-contain" />
			<span class="text-xs font-semibold text-white font-mono uppercase tracking-wider">YOG MEHTA</span>
		</a>
		<button 
			onclick="document.getElementById('mobile-admin-menu').classList.remove('hidden')" 
			class="p-2 text-neutral-300 hover:text-white focus:outline-none"
		>
			<img src="/static/icons/menu.svg" alt="Menu" style="width: 24px; height: 24px;" class="object-contain opacity-90 hover:opacity-100" />
		</button>
	</div>

	<!-- Mobile Full-Screen Overlay Menu -->
	<div id="mobile-admin-menu" class="hidden fixed inset-0 z-50 bg-[#181817] flex flex-col justify-between p-6 md:hidden">
		<div class="flex items-center justify-between">
			<a href="/" class="flex items-center gap-2.5">
				<img src="/static/images/logo.png" alt="logo" style="width: 28px; height: 28px;" class="object-contain" />
				<span class="text-sm font-semibold text-white font-mono uppercase tracking-wider">YOG MEHTA</span>
			</a>
			<button 
				onclick="document.getElementById('mobile-admin-menu').classList.add('hidden')" 
				class="p-2 text-neutral-400 hover:text-white focus:outline-none"
			>
				<img src="/static/icons/close.svg" alt="Close" style="width: 28px; height: 28px;" class="object-contain opacity-90 hover:opacity-100" />
			</button>
		</div>

		<nav class="my-auto flex flex-col items-center">
			<ul class="flex flex-col items-center gap-8 text-2xl font-medium tracking-tight">
				<li>
					<a href="/dashboard" class="text-white hover:text-white/80">Dashboard</a>
				</li>
				<li>
					<a href="/logout" class="text-red-400 hover:text-red-300">Log Out</a>
				</li>
			</ul>
		</nav>
	</div>

	<!-- Desktop Sidebar -->
	<aside class="dashboard-sidebar-aside bg-[#141413] flex flex-col justify-between p-5">
		<div class="space-y-6">

			<div class="px-2 pt-1">
				<a href="/" title="Go to Home" class="flex items-center gap-2.5 group">
					<img src="/static/images/logo.png" alt="Logo" style="width: 24px; height: 24px; max-width: 24px; max-height: 24px;" class="object-contain group-hover:opacity-80 transition-opacity" />
					<span class="text-xs font-semibold text-neutral-300 group-hover:text-white transition-colors tracking-wider font-mono uppercase">
						YOG MEHTA
					</span>
				</a>
			</div>

			<nav class="flex flex-col space-y-1">
				<a 
					href="/dashboard" 
					class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-medium text-white bg-neutral-800/80 hover:bg-neutral-800 transition-colors"
				>
					<img src="/static/icons/home.svg" alt="Home" style="width: 16px; height: 16px; min-width: 16px;" class="object-contain opacity-90" />
					<span>Dashboard</span>
				</a>
			</nav>
		</div>

		<div class="pt-4">
			<a 
				href="/logout"
				class="flex items-center justify-center gap-2 w-full px-3 py-2.5 rounded-xl text-xs font-medium text-red-400 hover:bg-red-950/30 transition-colors"
			>
				<img src="/static/icons/logout.svg" alt="Logout" style="width: 14px; height: 14px; min-width: 14px;" class="object-contain opacity-90" />
				<span>Log Out</span>
			</a>
		</div>
	</aside>
}