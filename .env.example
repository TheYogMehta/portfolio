# Server Configuration
PORT=3000

# PostgreSQL Database Connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portfolio?sslmode=disable

# SFTP Deployment Configuration
SFTP_HOST=your_server_ip_or_domain
SFTP_USER=your_username
SFTP_PORT=22
SFTP_REMOTE_DIR=/var/www/html

# SSH Private Key File Authentication
SFTP_KEY_FILE=~/.ssh/id_rsa
# SFTP_PASSPHRASE=